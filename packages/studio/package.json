{
  "name": "@patchwave/studio",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist/client",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "test": "tsx --test test/**/*.test.ts && vitest run",
    "fmt": "oxfmt package.json client src test tsconfig.json vite.config.ts",
    "fmt:check": "oxfmt --check package.json client src test tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "@babel/types": "7.28.4",
    "@patchwave/schema": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recast": "0.23.11",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
